\name{hello_taskr}
\alias{hello_taskr}
\title{Return a Friendly Package Message}
\usage{
hello_taskr(name = "researcher")
}
\arguments{
\item{name}{Character string used in the greeting.}
}
\value{
A single greeting string.
}
\description{
Provide a minimal exported function so the package has a clear, testable starting point.
}
\examples{
hello_taskr("researcher")
}
